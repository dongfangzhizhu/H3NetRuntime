# Vendored engine sources are kept without EOL rewriting. This repository
# carries local HyperFlow/ComfyUI-V8 fixes on top of the a474eca snapshot;
# see native/engine/ORIGIN.md for the list.
native/engine/** -text

# Windows batch files must keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf

*.png binary
*.mp4 binary
*.safetensors binary
