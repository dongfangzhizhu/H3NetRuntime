{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "H3": {
    "Edition": "general",
    "Host": "127.0.0.1",
    "Port": 7867,

    "_ModelDir": "留空则自动查找：h3.config.json 的 h3_dir → H3_MODEL_DIR → ~/h3-models/pdd8 → 程序目录下的 models/pdd8。填了就必须是包含 FL2VA/transformer/config.json 的模型包目录。",
    "ModelDir": "",
    "ModelRoot": "",
    "ConfigPath": "h3.config.json",
    "PackCacheDir": "",

    "_Models": "逐组件路径。留空的项回落到 ModelDir 指向的模型包里同名槽位；填了就在临时目录里用硬链接/目录联接拼出标准布局，不复制权重。",
    "Models": {
      "TextEncoder": "",
      "Transformer": "",
      "VideoVae": "",
      "AudioVae": "",
      "Tokenizer": "",
      "PddLora": "",
      "Ref2vaTransformer": "",
      "Ref2vaTextEncoder": "",
      "Ref2vaVideoVae": "",
      "Ref2vaAudioVae": "",
      "Ref2vaTokenizer": ""
    },

    "OutputDir": "work/outputs",
    "UploadDir": "work/uploads",
    "HistoryFile": "work/history.json",
    "PreloadOnStart": false,
    "MaxHistory": 60
  }
}
